# Copia este archivo como ".env" y llena tus valores reales.
# El ".env" NUNCA se sube al repositorio (ya está en el .gitignore).

# Cadena de conexión a MySQL:
DATABASE_URL=mysql+pymysql://usuario:contrasena@localhost:3306/food_express

# Para probar rápido en tu máquina sin instalar MySQL, puedes usar en su lugar:
# DATABASE_URL=sqlite:///./food_express.db

# Llave secreta para firmar los tokens JWT (usa una cadena larga y aleatoria)
SECRET_KEY=cambia-esta-llave-por-una-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Pagos (Sprint 3) ---
# Access Token de Mercado Pago (https://www.mercadopago.com.mx/developers).
# DÉJALO VACÍO para probar en MODO DEMO: el pago se simula con una página con
# botones "Aprobar" / "Rechazar", sin cobro real ni credenciales.
MERCADO_PAGO_ACCESS_TOKEN=

# URL pública https del backend (por ejemplo la de ngrok). Solo hace falta con
# Mercado Pago real si quieres webhook y regreso automático a la app.
PUBLIC_BASE_URL=

# Se usará en el Sprint 5:
GOOGLE_MAPS_API_KEY=
